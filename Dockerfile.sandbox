ARG CODEVIL_SANDBOX_PLATFORM=linux/amd64

FROM --platform=$CODEVIL_SANDBOX_PLATFORM node:22-slim AS builder
RUN npm install -g pnpm@10.28.1

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src
COPY packages/sandbox-image/package.json packages/sandbox-image/tsconfig.json ./packages/sandbox-image/
COPY packages/sandbox-image/src ./packages/sandbox-image/src

RUN pnpm install --filter @codevil/sandbox-image... --prod=false \
  && pnpm --filter @codevil/sandbox-image... build

RUN rm -rf node_modules \
  && pnpm install --filter @codevil/sandbox-image... --prod

FROM --platform=$CODEVIL_SANDBOX_PLATFORM docker.io/cloudflare/sandbox:0.12.7

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gh \
    ca-certificates \
    git \
    curl \
    wget \
    jq \
    zip \
    unzip \
    file \
    procps \
    util-linux \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@10.28.1 \
  && node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 19)) throw new Error(`Node ${process.versions.node} does not satisfy >=22.19`); console.log(process.version)' \
  && git --version \
  && bun --version \
  && setpriv --version

COPY --from=builder /app /app
ENV CODEVIL_PI_AGENT_DIR=/opt/codevil/pi-agent
COPY packages/sandbox-image/skills /opt/codevil/pi-agent/skills

RUN groupadd --gid 10001 codevil \
  && useradd --uid 10001 --gid codevil --home-dir /home/codevil --create-home codevil \
  && mkdir -p /workspace \
  && chown codevil:codevil /workspace

WORKDIR /workspace

EXPOSE 5173 8000 8080 3001
