ARG CODEVIL_SANDBOX_PLATFORM=linux/amd64

FROM --platform=$CODEVIL_SANDBOX_PLATFORM node:20-slim AS builder
RUN npm install -g pnpm@10.28.1

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src
COPY packages/sandbox-image/package.json packages/sandbox-image/tsconfig.json ./packages/sandbox-image/
COPY packages/sandbox-image/src ./packages/sandbox-image/src

RUN pnpm install --filter @codevil/sandbox-image... --prod=false \
  && pnpm --filter @codevil/sandbox-image... build

RUN rm -rf node_modules \
  && pnpm install --filter @codevil/sandbox-image... --prod

FROM --platform=$CODEVIL_SANDBOX_PLATFORM docker.io/cloudflare/sandbox:0.3.7

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends gh ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@10.28.1

COPY --from=builder /app /app

EXPOSE 5173 8000 8080 3001
