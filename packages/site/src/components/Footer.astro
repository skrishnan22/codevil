---
import Logo from "./Logo.astro";
import { FOOTER_LINKS } from "../data/site";
---
<footer class="border-t border-line">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 py-14">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
      <div class="flex flex-col gap-3">
        <Logo />
        <p class="max-w-sm text-sm text-fg-3">
          Self-hosted AI coding agents. Your cloud, your keys, your rules.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {FOOTER_LINKS.map((link) => (
          <a href={link.href} class="text-sm text-fg-3 transition-colors hover:text-fg">
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="border-t border-line pt-6 font-mono text-xs text-fg-4">
      © {new Date().getFullYear()} Codevil. Self-hosted.
    </div>
  </div>
</footer>
