---
import Section from "./Section.astro";

const steps = [
  {
    n: "01",
    title: "Describe the task",
    body: "codevil run \"add rate limiting to the API\" --repo github.com/you/repo",
    code: true,
  },
  {
    n: "02",
    title: "Pi plans (read-only)",
    body: "Pi explores the repo with read, grep, find, ls — no bash, edit, or write tools are available during planning. The model cannot modify the repo.",
  },
  {
    n: "03",
    title: "You approve",
    body: "Review the plan. Approve, abort, or refine conversationally — up to 5 rounds. Write tools are unlocked only after explicit approval.",
  },
  {
    n: "04",
    title: "Pi executes & verifies",
    body: "Pi makes the changes, then runs the repo's own tests and linters. Retries up to 5 times on failure, escalating with full error context.",
  },
  {
    n: "05",
    title: "PR opened",
    body: "A branch is pushed and a draft PR is opened via gh, with the approved plan as the PR body. Code review happens on GitHub.",
  },
];
---
<Section id="how-it-works" eyebrow="Lifecycle" title="From prompt to pull request">
  <ol class="flex flex-col gap-0 divide-y divide-line border-y border-line">
    {steps.map((step) => (
      <li class="grid gap-4 py-6 sm:grid-cols-[auto_1fr] sm:gap-8">
        <span class="font-mono text-sm text-accent">{step.n}</span>
        <div>
          <h3 class="text-lg font-semibold tracking-tight text-fg">{step.title}</h3>
          {step.code ? (
            <pre class="mt-3 overflow-x-auto rounded-md border border-line bg-surface px-4 py-3 font-mono text-[13px] text-fg-2"><code>{step.body}</code></pre>
          ) : (
            <p class="mt-2 text-fg-3">{step.body}</p>
          )}
        </div>
      </li>
    ))}
  </ol>
</Section>
