---
const lifecycle = [
  { label: "Cloning repo", state: "done" },
  { label: "Planning — read-only tools", state: "done" },
  { label: "Plan ready: add rate limiting to /api", state: "done" },
  { label: "Approved by you", state: "done" },
  { label: "Executing — bash, edit, write unlocked", state: "active" },
  { label: "Verifying — pnpm test", state: "pending" },
];
const toolTrace = [
  { tool: "read", target: "src/server.ts", detail: "62 lines" },
  { tool: "grep", target: "rate", detail: "3 matches" },
  { tool: "edit", target: "src/server.ts", detail: "+14 −2" },
  { tool: "bash", target: "pnpm test", detail: "running…" },
];
---
<div class="overflow-hidden rounded-xl border border-line bg-surface shadow-2xl shadow-fg/5">
  <div class="flex items-center gap-2 border-b border-line bg-surface-2 px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-accent/60"></span>
    <span class="ml-3 font-mono text-xs text-fg-4">codevil · session ses_abc123</span>
  </div>
  <div class="grid grid-cols-3 divide-x divide-line text-left">
    <div class="flex flex-col gap-3 p-4">
      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-4">Conversation</span>
      <div class="rounded-md bg-surface-3 p-3 text-xs text-fg-2">
        Add rate limiting to the public API.
      </div>
      <div class="rounded-md border border-accent/30 bg-accent-soft p-3 text-xs text-fg-2">
        <span class="font-semibold text-accent">Plan</span> — Add a token-bucket limiter in
        <code class="font-mono text-fg-3">src/middleware.ts</code>, wire it before the router,
        add a <code class="font-mono text-fg-3">RATE_LIMIT</code> env read.
      </div>
      <div class="self-end rounded-md bg-accent px-3 py-1.5 text-xs font-medium text-accent-fg">
        Approved
      </div>
    </div>
    <div class="flex flex-col gap-2 p-4">
      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-4">Activity</span>
      {lifecycle.map((item) => (
        <div class="flex items-center gap-2 text-xs">
          <span
            class={
              "h-2 w-2 flex-shrink-0 rounded-full " +
              (item.state === "done"
                ? "bg-accent"
                : item.state === "active"
                  ? "bg-accent ring-4 ring-accent/20"
                  : "bg-line")
              }
            aria-hidden="true"
          />
          <span class={item.state === "pending" ? "text-fg-4" : "text-fg-2"}>{item.label}</span>
        </div>
      ))}
    </div>
    <div class="flex flex-col gap-2 p-4">
      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-4">Tool Trace</span>
      {toolTrace.map((t) => (
        <div class="flex items-center justify-between rounded-md bg-surface-2 px-2.5 py-1.5 font-mono text-[11px]">
          <span class="text-accent">{t.tool}</span>
          <span class="text-fg-2">{t.target}</span>
          <span class="text-fg-4">{t.detail}</span>
        </div>
      ))}
    </div>
  </div>
</div>
