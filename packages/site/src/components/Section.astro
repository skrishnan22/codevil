---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
}
const { id, eyebrow, title, class: className } = Astro.props;
---
<section id={id} class={`mx-auto w-full max-w-5xl px-6 py-20${className ? ` ${className}` : ""}`}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.16em] text-fg-4">{eyebrow}</p>}
  {title && <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h2>}
  <div class="mt-8">
    <slot />
  </div>
</section>
