# Copy this file to .env.production and replace every REPLACE_ME placeholder.
# WARNING: Do not upload this file while any REPLACE_ME placeholder remains.
# Upload it with: pnpm exec wrangler secret bulk .env.production

CODEVIL_API_KEY=REPLACE_ME_WITH_AN_INDEPENDENT_RANDOM_VALUE
CODEVIL_SETUP_TOKEN=REPLACE_ME_WITH_A_DIFFERENT_INDEPENDENT_RANDOM_VALUE
CODEVIL_PROXY_SIGNING_SECRET=REPLACE_ME_WITH_A_THIRD_INDEPENDENT_RANDOM_VALUE
BETTER_AUTH_SECRET=REPLACE_ME_WITH_A_FOURTH_INDEPENDENT_RANDOM_VALUE

GITHUB_PAT=REPLACE_ME_WITH_YOUR_FINE_GRAINED_GITHUB_TOKEN
GOOGLE_CLIENT_ID=REPLACE_ME_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_ME_WITH_YOUR_GOOGLE_OAUTH_CLIENT_SECRET
