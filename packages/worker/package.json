{
  "name": "@codevil/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check:migrations": "node scripts/check-d1-migrations.mjs",
    "dev": "wrangler dev",
    "deploy": "pnpm --filter '@codevil/web...' run build && wrangler deploy",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.7",
    "@codevil/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "typescript": "^5.8.0",
    "wrangler": "~4.100.0"
  }
}
